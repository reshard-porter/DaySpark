<?xml version="1.0" encoding="utf-8"?>
<!-- Miniature dashboard. Inflated with a ContextThemeWrapper, so every ?attr resolves to the
     previewed theme's colors rather than the current one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:importantForAccessibility="noHideDescendants"
    android:minHeight="@dimen/preview_height"
    android:orientation="vertical"
    android:padding="@dimen/space_l">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preview_sample_heading"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_m">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/preview_sample_habit"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="?attr/colorPrimary"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorOnPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/preview_sample_streak"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/bg_badge"
            android:backgroundTint="?attr/colorPrimary"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/preview_sample_button"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
