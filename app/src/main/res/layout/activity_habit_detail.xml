<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/menu_detail" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.dayspark.app.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                android:id="@+id/detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                android:id="@+id/detail_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/detail_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                app:icon="@drawable/ic_check" />

            <TextView
                style="@style/Widget.DaySpark.SectionLabel"
                android:accessibilityHeading="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_progress" />

            <GridLayout
                android:id="@+id/stats_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false" />

            <TextView
                style="@style/Widget.DaySpark.SectionLabel"
                android:accessibilityHeading="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_history" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <GridLayout
                    android:id="@+id/history_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:padding="@dimen/space_m" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <View
                    android:id="@+id/legend_done"
                    android:layout_width="@dimen/day_dot"
                    android:layout_height="@dimen/day_dot"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginEnd="@dimen/space_l"
                    android:text="@string/legend_done"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                <View
                    android:id="@+id/legend_missed"
                    android:layout_width="@dimen/day_dot"
                    android:layout_height="@dimen/day_dot"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:text="@string/legend_missed"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />
            </LinearLayout>
        </com.dayspark.app.ui.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
