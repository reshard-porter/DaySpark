<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_themes" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.dayspark.app.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/space_xxl">

            <include
                android:id="@+id/purchase_card"
                layout="@layout/view_purchase_card" />

            <TextView
                style="@style/Widget.DaySpark.SectionLabel"
                android:accessibilityHeading="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_all_themes" />

            <LinearLayout
                android:id="@+id/theme_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.dayspark.app.ui.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
