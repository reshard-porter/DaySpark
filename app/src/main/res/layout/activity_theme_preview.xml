<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <com.dayspark.app.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- The real dashboard adapter, fed sample habits -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/preview_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/space_l" />
    </com.dayspark.app.ui.MaxWidthLinearLayout>

    <com.dayspark.app.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_m">

        <include
            android:id="@+id/purchase_card"
            layout="@layout/view_purchase_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/preview_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/action_use_theme"
            android:visibility="gone" />
    </com.dayspark.app.ui.MaxWidthLinearLayout>
</LinearLayout>
