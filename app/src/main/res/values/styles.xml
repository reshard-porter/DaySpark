<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Typography (all sizes in sp so they follow the system font scale) ===== -->
    <style name="TextAppearance.DaySpark.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.DaySpark.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.DaySpark.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.DaySpark.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.DaySpark.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.DaySpark.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.DaySpark.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.DaySpark.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.DaySpark.Stat" parent="TextAppearance.DaySpark.Headline">
        <item name="android:textSize">24sp</item>
    </style>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.DaySpark.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>
    <style name="ShapeAppearance.DaySpark.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>
    <style name="ShapeAppearance.DaySpark.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>
    <style name="ShapeAppearance.DaySpark.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <!-- ===== Components ===== -->
    <style name="Widget.DaySpark.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAppearance">@style/TextAppearance.DaySpark.Label</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
    </style>
    <style name="Widget.DaySpark.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textAppearance">@style/TextAppearance.DaySpark.Label</item>
    </style>
    <style name="Widget.DaySpark.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.DaySpark.Label</item>
    </style>
    <!-- Round check toggle on habit rows -->
    <style name="Widget.DaySpark.CheckButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:minWidth">@dimen/check_button_size</item>
        <item name="android:minHeight">@dimen/check_button_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="iconSize">@dimen/icon_m</item>
    </style>
    <style name="Widget.DaySpark.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/stroke_card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.DaySpark.Card.Tinted">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.DaySpark.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="titleTextAppearance">@style/TextAppearance.DaySpark.Title</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.DaySpark.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.DaySpark.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target</item>
    </style>
    <style name="Widget.DaySpark.SectionLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.DaySpark.Caption</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>
    <!-- Full-width tappable settings row -->
    <style name="Widget.DaySpark.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
